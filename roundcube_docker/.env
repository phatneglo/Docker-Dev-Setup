# ---------------------------------------------
# ITBS PNP Mail - All-in-one Mail + Roundcube
# Copy this file to .env before running Docker.
# ---------------------------------------------

COMPOSE_PROJECT_NAME=itbs-pnp-mail
TZ=Asia/Manila

# Web UI
ROUNDCUBE_HTTP_PORT=8080

# Mail Admin UI
MAIL_ADMIN_UI_PORT=8092
MAIL_ADMIN_UI_EMAIL=admin@itbsstudio.com
MAIL_ADMIN_UI_PASSWORD=ChangeMeNow123!
MAIL_ADMIN_COOKIE_SECURE=false
MAILSERVER_CONTAINER=itbs-pnp-mail-mailserver

# Mailserver identity. Your MX record should point at MAIL_FQDN.
MAIL_HOSTNAME=mail
MAIL_DOMAIN=itbsstudio.com
MAIL_FQDN=mail.itbsstudio.com
MAIL_LOG_LEVEL=info

# Leave empty for local/dev bootstrap. For production, switch to manual or letsencrypt.
MAIL_SSL_TYPE=

# Host ports for the mail server.
MAIL_SMTP_PORT=25
MAIL_SMTPS_PORT=465
MAIL_SUBMISSION_PORT=587
MAIL_IMAP_PORT=143
MAIL_IMAPS_PORT=993

# Bootstrap mailbox. This is created automatically into data/mailserver/config/postfix-accounts.cf.
MAIL_ADMIN_ADDRESS=admin@itbsstudio.com
MAIL_ADMIN_PASSWORD=ChangeMeNow123!

# Roundcube database
MYSQL_ROOT_PASSWORD=change_me_super_root_password
ROUNDCUBEMAIL_DB_NAME=roundcubemail
ROUNDCUBEMAIL_DB_USER=roundcube
ROUNDCUBEMAIL_DB_PASSWORD=change_me_roundcube_db_password
ROUNDCUBE_DES_KEY=change_this_24_char_key!!

# Roundcube defaults. Local/dev uses the internal Docker network, so plain IMAP is OK.
ROUNDCUBEMAIL_DEFAULT_HOST=mailserver
ROUNDCUBEMAIL_DEFAULT_PORT=143
ROUNDCUBEMAIL_SMTP_SERVER=mailserver
ROUNDCUBEMAIL_SMTP_PORT=587
ROUNDCUBEMAIL_USERNAME_DOMAIN=itbsstudio.com

# Branding
ROUNDCUBEMAIL_PRODUCT_NAME=PNP Mail
ITBS_BRAND_NAME=PNP Mail
ITBS_SUPPORT_EMAIL=support@itbsstudio.com
ITBS_BRAND_PRIMARY=#0B2E59
ITBS_BRAND_GOLD=#F2C94C
ITBS_BRAND_RED=#C62828

# Built-in Roundcube plugins
ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,itbs_ai_assistant
ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=25M

# AI API host bind. 8090 is already used elsewhere in this repo.
AI_API_HTTP_PORT=8091
ITBS_AI_TITLE=PNP Mail AI
ITBS_AI_API_URL=http://ai-api:8090
ITBS_AI_SHARED_SECRET=change_me_ai_shared_secret
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# auto = mock when OPENAI_API_KEY is empty, real AI when OPENAI_API_KEY is set.
# Use true to force mock mode, or false to require a real AI key.
AI_MOCK_MODE=auto
AI_MAX_INPUT_CHARS=12000
AI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=xxx
