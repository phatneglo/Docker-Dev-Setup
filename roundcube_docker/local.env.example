# ---------------------------------------------
# ITBS PNP Mail - local development template
# Copy to local.env, then run:
#   docker compose --env-file local.env up -d --build
# ---------------------------------------------

COMPOSE_PROJECT_NAME=itbs-pnp-mail-local
TZ=Asia/Manila

# Local browser access
ROUNDCUBE_HTTP_PORT=8080
MAIL_ADMIN_UI_PORT=8092
AI_API_HTTP_PORT=8091

# Local admin UI login
MAIL_ADMIN_UI_EMAIL=admin@itbsstudio.com
MAIL_ADMIN_UI_PASSWORD=ChangeMeNow123!
MAIL_ADMIN_COOKIE_SECURE=false
MAILSERVER_CONTAINER=itbs-pnp-mail-local-mailserver

# Mail identity used inside the stack.
# Keep this matching production if you want realistic mailbox addresses.
MAIL_HOSTNAME=mail
MAIL_DOMAIN=itbsstudio.com
MAIL_FQDN=mail.itbsstudio.com
MAIL_LOG_LEVEL=info

# Local/dev uses no public TLS in docker-mailserver.
MAIL_SSL_TYPE=

# Host ports for local testing.
MAIL_SMTP_PORT=25
MAIL_SMTPS_PORT=465
MAIL_SUBMISSION_PORT=587
MAIL_IMAP_PORT=143
MAIL_IMAPS_PORT=993

# First local mailbox.
MAIL_ADMIN_ADDRESS=admin@itbsstudio.com
MAIL_ADMIN_PASSWORD=ChangeMeNow123!

# Local database/session secrets.
# These are acceptable only for local development.
MYSQL_ROOT_PASSWORD=local_root_password
ROUNDCUBEMAIL_DB_NAME=roundcubemail
ROUNDCUBEMAIL_DB_USER=roundcube
ROUNDCUBEMAIL_DB_PASSWORD=local_roundcube_db_password
ROUNDCUBE_DES_KEY=local_dev_24_chars_key!!
ROUNDCUBE_FORCE_HTTPS=false

# Roundcube talks to mailserver over the internal Docker network.
ROUNDCUBEMAIL_DEFAULT_HOST=mailserver
ROUNDCUBEMAIL_DEFAULT_PORT=143
ROUNDCUBEMAIL_SMTP_SERVER=mailserver
ROUNDCUBEMAIL_SMTP_PORT=587
ROUNDCUBEMAIL_USERNAME_DOMAIN=itbsstudio.com

# Branding
ROUNDCUBEMAIL_PRODUCT_NAME=PNP Mail
ITBS_BRAND_NAME=PNP Mail
ITBS_SUPPORT_EMAIL=support@itbsstudio.com
ITBS_BRAND_PRIMARY=#0B2E59
ITBS_BRAND_GOLD=#F2C94C
ITBS_BRAND_RED=#C62828

# Roundcube plugins
ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,itbs_ai_assistant
ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=25M

# AI API
ITBS_AI_TITLE=PNP Mail AI
ITBS_AI_API_URL=http://ai-api:8090
ITBS_AI_SHARED_SECRET=local_ai_shared_secret
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MOCK_MODE=auto
AI_MAX_INPUT_CHARS=12000
AI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
