# ---------------------------------------------
# ITBS PNP Mail - AWS EC2 production template
# Copy to remote.env on the EC2 instance, edit every CHANGE_ME value, then run:
#   docker compose --env-file remote.env up -d --build
# ---------------------------------------------

COMPOSE_PROJECT_NAME=itbs-pnp-mail
TZ=Asia/Manila

# Public service ports on EC2.
# Put Nginx/Caddy/Traefik on 80/443 and proxy webmail to 127.0.0.1:8080.
ROUNDCUBE_HTTP_PORT=127.0.0.1:8080
MAIL_ADMIN_UI_PORT=127.0.0.1:8092
AI_API_HTTP_PORT=127.0.0.1:8091

# Mail admin UI.
# Keep this private through SSH tunnel, VPN, or a reverse proxy with IP allowlisting.
MAIL_ADMIN_UI_EMAIL=admin@itbsstudio.com
MAIL_ADMIN_UI_PASSWORD=CHANGE_ME_STRONG_ADMIN_UI_PASSWORD
MAIL_ADMIN_COOKIE_SECURE=true
MAILSERVER_CONTAINER=itbs-pnp-mail-mailserver

# Mailserver identity. Cloudflare MX should point to MAIL_FQDN.
MAIL_HOSTNAME=mail
MAIL_DOMAIN=itbsstudio.com
MAIL_FQDN=mail.itbsstudio.com
MAIL_LOG_LEVEL=info

# Production TLS for docker-mailserver.
# With letsencrypt, certificates must exist under:
#   ./data/letsencrypt/live/mail.itbsstudio.com/fullchain.pem
#   ./data/letsencrypt/live/mail.itbsstudio.com/privkey.pem
# This folder is mounted read-only to /etc/letsencrypt in the mailserver container.
MAIL_SSL_TYPE=letsencrypt

# Public mail ports.
MAIL_SMTP_PORT=25
MAIL_SMTPS_PORT=465
MAIL_SUBMISSION_PORT=587
# Prefer not to expose plain IMAP on the internet. Use IMAPS 993 for clients.
MAIL_IMAP_PORT=127.0.0.1:143
MAIL_IMAPS_PORT=993

# First production mailbox. Change before first boot.
MAIL_ADMIN_ADDRESS=admin@itbsstudio.com
MAIL_ADMIN_PASSWORD=CHANGE_ME_STRONG_MAILBOX_PASSWORD

# Production database/session secrets.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_ROOT_PASSWORD
ROUNDCUBEMAIL_DB_NAME=roundcubemail
ROUNDCUBEMAIL_DB_USER=roundcube
ROUNDCUBEMAIL_DB_PASSWORD=CHANGE_ME_STRONG_ROUNDCUBE_DB_PASSWORD
# Must be exactly 24 characters for Roundcube.
ROUNDCUBE_DES_KEY=CHANGE_ME_24_CHARS_KEY!!
ROUNDCUBE_FORCE_HTTPS=true

# Roundcube internal mail backend.
ROUNDCUBEMAIL_DEFAULT_HOST=mailserver
ROUNDCUBEMAIL_DEFAULT_PORT=143
ROUNDCUBEMAIL_SMTP_SERVER=mailserver
ROUNDCUBEMAIL_SMTP_PORT=587
ROUNDCUBEMAIL_USERNAME_DOMAIN=itbsstudio.com

# Branding
ROUNDCUBEMAIL_PRODUCT_NAME=PNP Mail
ITBS_BRAND_NAME=PNP Mail
ITBS_SUPPORT_EMAIL=support@itbsstudio.com
ITBS_BRAND_PRIMARY=#0B2E59
ITBS_BRAND_GOLD=#F2C94C
ITBS_BRAND_RED=#C62828

# Roundcube plugins
ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,itbs_ai_assistant
ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=25M

# AI API
ITBS_AI_TITLE=PNP Mail AI
ITBS_AI_API_URL=http://ai-api:8090
ITBS_AI_SHARED_SECRET=CHANGE_ME_STRONG_AI_SHARED_SECRET
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# auto = mock when OPENAI_API_KEY is empty, real AI when OPENAI_API_KEY is set.
AI_MOCK_MODE=auto
AI_MAX_INPUT_CHARS=12000
AI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
