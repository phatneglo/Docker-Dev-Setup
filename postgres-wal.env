# PostgreSQL HA + WAL stack settings.
# Host port 55432 avoids conflict with a local Windows PostgreSQL on 5432.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=0yq5h3to9
POSTGRES_SUPERUSER_PASSWORD=0yq5h3to9
REPMGR_PASSWORD=0yq5h3to9
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=0yq5h3to9
POSTGRES_HOST_PORT=55432
POSTGRES_EXPORTER_HOST_PORT=9187

# Backup API and scheduler.
# Swagger: http://localhost:8090/swagger
BACKUP_API_HOST_PORT=8090
BACKUP_API_PORT=8080
BACKUP_API_KEY=change-backup-api-key
PITR_RESTORE_HOST_PORT=55433
BACKUP_SCHEDULE_ENABLED=true
BACKUP_DAILY_TIME=02:00
BACKUP_TIMEZONE=Asia/Manila
BACKUP_RETENTION_COUNT=7
BACKUP_TIMEOUT_MINUTES=120
BACKUP_WAL_UPLOAD_ENABLED=true
BACKUP_WAL_UPLOAD_INTERVAL_SECONDS=60
BACKUP_WAL_UPLOAD_BATCH_SIZE=10
BACKUP_WAL_UPLOAD_FORCE_SWITCH=false
BACKUP_POSTGRES_HOST=pg-0
BACKUP_POSTGRES_PORT=5432
BACKUP_LOCAL_DIR=/backups
BACKUP_WAL_DIR=/wal-archive

# S3-compatible backup storage. Set BACKUP_S3_ENABLED=true after filling these.
BACKUP_S3_ENABLED=true
BACKUP_S3_ENDPOINT=http://10.10.0.85:9010
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=postgres-wal
BACKUP_S3_PREFIX=app-backup
BACKUP_S3_ACCESS_KEY_ID=s3phatneglo-archive
BACKUP_S3_SECRET_ACCESS_KEY=0yq5h3to9
BACKUP_S3_FORCE_PATH_STYLE=true
